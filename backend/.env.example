# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Absolute URL used when building public upload links (defaults to http://localhost:PORT)
PUBLIC_BASE_URL=http://localhost:5000

# Database — new AI Studio app (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_studio?schema=public

# Database — restored Odoo dump (migration source only; app does not use this at runtime)
ODOO_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jini

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Paymob (Egypt) - get these from https://accept.paymob.com/portal2/en/dashboard
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID_CARD=your_card_integration_id
PAYMOB_INTEGRATION_ID_WALLET=your_wallet_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret

# --- AI Providers (fill in the ones you use) ---
# FAL.AI — primary for Hailuo, Veo, Kling via FAL, Kontext, etc.
FAL_KEY=
# Alias accepted by falClient:
# FAL_API_KEY=

# RunwayML — Gen4 / Act-Two / upscale
RUNWAY_API_KEY=
# Alias: RUNWAYML_API_SECRET=

# WaveSpeed — Kling O3, Seedance 2, Nano Banana via WaveSpeed, Grok, etc.
WAVESPEED_API_KEY=
# Alias: WAVESPEED_API_TOKEN=

# AIML API — Flux Pro / Imagen via aimlapi.com
AIML_API_KEY=
# Alias: AIMLAPI_KEY=

# Optional SDKs (install packages if you enable these)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
GOOGLE_AI_API_KEY=

# Credit pricing defaults (overridden by DB CreditConfig when seeded)
IMAGE_CREDIT_COST=18
VIDEO_CREDIT_COST=60
AUDIO_CREDIT_COST=10
